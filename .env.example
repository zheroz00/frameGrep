# frameGrep environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is gitignored — never commit real keys.
#
# You do NOT need all of these. At minimum, set ONE provider:
#   - Gemini (easiest):        VITE_GEMINI_API_KEY
#   - OpenRouter (cloud VLM):  VITE_OPENROUTER_API_KEY
#   - Local (vLLM/Marlin):     no API key, but see the local-inference section
# Any key left blank can also be entered in the in-app Settings UI.
# ===========================================================================

# --- Cloud AI providers (client-side, read at build time by Vite) ----------

# Google Gemini — native full-video analysis. Get a key: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# OpenRouter — any OpenAI-compatible vision model (frame extraction).
# Get a key: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1
VITE_OPENROUTER_MODEL=qwen/qwen3-vl-235b-a22b-instruct

# Jamendo — royalty-free music suggestions. Register an app: https://devportal.jamendo.com/
VITE_JAMENDO_CLIENT_ID=

# --- Optional client-side tuning -------------------------------------------

# Frame extraction (Custom/OpenRouter/llama.cpp path). Leave unset for adaptive defaults.
# VITE_FRAME_EXTRACTION_FPS=0.5   # fixed frames/sec (default: adaptive by clip length)
# VITE_MAX_FRAMES=200             # frame budget ceiling for cloud VLMs

# Local Marlin-2B server endpoint (default: /api/marlin, proxied to :8003).
# VITE_MARLIN_ENDPOINT=/api/marlin

# --- Production build only --------------------------------------------------
# `npm run build` inlines this into the bundle as process.env.GEMINI_API_KEY.
# WARNING: anyone with the built dist/ can read it. Leave blank for dev (use VITE_GEMINI_API_KEY).
# GEMINI_API_KEY=

# ===========================================================================
# LOCAL INFERENCE (self-hosting vLLM / Marlin) — optional
# Only needed if you run the local model servers in scripts/. See
# docs/local-inference-cheatsheet.md. Requires an NVIDIA GPU + ffmpeg/NVENC.
# ===========================================================================

# Hugging Face token — needed to download the gated NemoStation/Marlin-2B model
# and any gated vLLM model. Get one: https://huggingface.co/settings/tokens
HF_TOKEN=

# vLLM model selection (sourced by scripts/vllm-server.sh)
VLLM_MODEL=cyankiwi/Qwen3-VL-8B-Instruct-AWQ-4bit
VLLM_MAX_LEN=32768
# VLLM_GPU_MEM_UTIL=0.95
# VLLM_PORT=8002

# HF cache location (defaults to ~/.cache/huggingface). Point these at a larger/
# persistent drive if you want weights to survive a ~/.cache wipe.
# HF_HOME=/path/to/hf-cache
# HF_HUB_CACHE=/path/to/hf-cache/hub

# Interpreter overrides — set only if `vllm` / `python` aren't on your PATH
# (e.g. a conda or venv install).
# VLLM_BIN=/path/to/vllm
# PYTHON_BIN=/path/to/python

# --- Dev server / transcode (optional) -------------------------------------
# GPU index for NVENC transcoding (/api/transcode). Default 0.
# NVENC_GPU=0
# Expose the dev server on your own domain (added to Vite allowedHosts).
# ALLOWED_HOST=frame.example.com
# Per-service overrides consumed by scripts/ecosystem.config.cjs:
# GPU=0     # CUDA device index for a local model server
# PORT=8002 # port override for a local model server
