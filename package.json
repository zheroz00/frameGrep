{
  "name": "framegrep",
  "version": "0.1.0",
  "private": true,
  "description": "Analyze FPV/drone footage to auto-identify highlight clips and export them to DaVinci Resolve, Premiere, or FFmpeg. Powered by Google Gemini, OpenRouter, or local vision models.",
  "license": "AGPL-3.0-only",
  "author": "zheroz00",
  "homepage": "https://github.com/zheroz00/frameGrep#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/zheroz00/frameGrep.git"
  },
  "bugs": {
    "url": "https://github.com/zheroz00/frameGrep/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:smoke": "node --test scripts/stabilization-smoke.test.mjs",
    "check": "npm run typecheck && npm run typecheck:tests && npm test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^1.33.0",
    "lucide-react": "^0.561.0",
    "mediainfo.js": "^0.3.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
